        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\n  &#39;flowchart&#39;: {\n    &#39;nodeSpacing&#39;: 75,\n    &#39;rankSpacing&#39;: 160,\n    &#39;curve&#39;: &#39;stepAfter&#39;,\n    &#39;padding&#39;: 30\n  }\n}}%%\nflowchart LR\n    %% Estilização Padronizada (Identidade Visual por Domínio)\n    classDef geoCliente fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1,font-weight:bold\n    classDef rhAgencia fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1B5E20,font-weight:bold\n    classDef fornecedor fill:#FFF3E0,stroke:#EF6C00,stroke-width:2px,color:#E65100,font-weight:bold\n    classDef produto fill:#F3E5F5,stroke:#6A1B9A,stroke-width:2px,color:#4A148C,font-weight:bold\n    classDef pacote fill:#E0F7FA,stroke:#00838F,stroke-width:2px,color:#006064,font-weight:bold\n    classDef reserva fill:#FCE4EC,stroke:#C2185B,stroke-width:2px,color:#880E4F,font-weight:bold\n    classDef financeiro fill:#FFFDE7,stroke:#F9A825,stroke-width:2px,color:#F57F17,font-weight:bold\n\n    %% ==========================================\n    %% 1. CORE DE CLIENTES E CRM (1 - 7)\n    %% ==========================================\n    subgraph G1 [1. Clientes e Localização]\n        direction TB\n        PAISES[PAISES]:::geoCliente\n        ESTADOS[ESTADOS]:::geoCliente\n        CIDADES[CIDADES]:::geoCliente\n        ENDERECOS[ENDERECOS]:::geoCliente\n        CLIENTES[CLIENTES]:::geoCliente\n        DOCUMENTOS_CLIENTES[DOCUMENTOS_CLIENTES]:::geoCliente\n        PREFERENCIAS_CLIENTES[PREFERENCIAS_CLIENTES]:::geoCliente\n    end\n\n    %% ==========================================\n    %% 2. RECURSOS HUMANOS E AGÊNCIAS (8 - 13)\n    %% ==========================================\n    subgraph G2 [2. RH e Agências]\n        direction TB\n        FILIAIS[FILIAIS]:::rhAgencia\n        DEPARTAMENTOS[DEPARTAMENTOS]:::rhAgencia\n        CARGOS[CARGOS]:::rhAgencia\n        FUNCIONARIOS[FUNCIONARIOS]:::rhAgencia\n        AGENTES_VIAGEM[AGENTES_VIAGEM]:::rhAgencia\n        METAS_VENDAS[METAS_VENDAS]:::rhAgencia\n    end\n\n    %% ==========================================\n    %% 3. FORNECEDORES E PARCEIROS (14 - 20)\n    %% ==========================================\n    subgraph G3 [3. Fornecedores e Parceiros]\n        direction TB\n        FORNECEDORES[FORNECEDORES]:::fornecedor\n        CONTATOS_FORNECEDORES[CONTATOS_FORNECEDORES]:::fornecedor\n        CONTRATOS_FORNECEDORES[CONTRATOS_FORNECEDORES]:::fornecedor\n        COMPANHIAS_AEREAS[COMPANHIAS_AEREAS]:::fornecedor\n        REDES_HOTELEIRAS[REDES_HOTELEIRAS]:::fornecedor\n        LOCADORAS_VEICULOS[LOCADORAS_VEICULOS]:::fornecedor\n        SEGURADORAS[SEGURADORAS]:::fornecedor\n    end\n\n    %% ==========================================\n    %% 4. CATÁLOGO DE PRODUTOS E SERVIÇOS (21 - 31)\n    %% ==========================================\n    subgraph G4 [4. Catálogo de Produtos e Serviços]\n        direction TB\n        AEROPORTOS[AEROPORTOS]:::produto\n        VOOS[VOOS]:::produto\n        CLASSES_VOOS[CLASSES_VOOS]:::produto\n        HOTEIS[HOTEIS]:::produto\n        TIPOS_QUARTOS[TIPOS_QUARTOS]:::produto\n        REGIMES_ALIMENTACAO[REGIMES_ALIMENTACAO]:::produto\n        TARIFAS_HOTEIS[TARIFAS_HOTEIS]:::produto\n        CATEGORIAS_VEICULOS[CATEGORIAS_VEICULOS]:::produto\n        PLANOS_SEGURO[PLANOS_SEGURO]:::produto\n        PASSEIOS_TOURS[PASSEIOS_TOURS]:::produto\n        CRUZEIROS[CRUZEIROS]:::produto\n    end\n\n    %% ==========================================\n    %% 5. PACOTES TURÍSTICOS (32 - 36)\n    %% ==========================================\n    subgraph G5 [5. Pacotes Turísticos]\n        direction TB\n        PACOTES_VIAGEM[PACOTES_VIAGEM]:::pacote\n        PACOTES_VOOS[PACOTES_VOOS]:::pacote\n        PACOTES_HOTEIS[PACOTES_HOTEIS]:::pacote\n        PACOTES_PASSEIOS[PACOTES_PASSEIOS]:::pacote\n        PROMOCOES_PACOTES[PROMOCOES_PACOTES]:::pacote\n    end\n\n    %% ==========================================\n    %% 6. VENDAS E RESERVAS (37 - 43)\n    %% ==========================================\n    subgraph G6 [6. Vendas e Reservas]\n        direction TB\n        COTACOES[COTACOES]:::reserva\n        RESERVAS[RESERVAS]:::reserva\n        PASSAGEIROS_RESERVA[PASSAGEIROS_RESERVA]:::reserva\n        RESERVAS_VOOS[RESERVAS_VOOS]:::reserva\n        RESERVAS_HOTEIS[RESERVAS_HOTEIS]:::reserva\n        RESERVAS_VEICULOS[RESERVAS_VEICULOS]:::reserva\n        RESERVAS_EXTRAS[RESERVAS_EXTRAS]:::reserva\n    end\n\n    %% ==========================================\n    %% 7. FINANCEIRO, FIDELIDADE E PÓS-VENDA (44 - 50)\n    %% ==========================================\n    subgraph G7 [7. Financeiro e Pós-Venda]\n        direction TB\n        FORMAS_PAGAMENTO[FORMAS_PAGAMENTO]:::financeiro\n        PAGAMENTOS[PAGAMENTOS]:::financeiro\n        COMISSOES[COMISSOES]:::financeiro\n        CONTAS_PAGAR_FORNECEDORES[CONTAS_PAGAR_FORNECEDORES]:::financeiro\n        PROGRAMA_FIDELIDADE[PROGRAMA_FIDELIDADE]:::financeiro\n        MOVIMENTACAO_PONTOS[MOVIMENTACAO_PONTOS]:::financeiro\n        AVALIACOES_VIAGEM[AVALIACOES_VIAGEM]:::financeiro\n    end\n\n    %% ==========================================\n    %% RELACIONAMENTOS E CARDINALIDADES (1,1 | 1,n)\n    %% ==========================================\n    \n    %% Domínio 1\n    PAISES ---|\&quot;1,n\&quot;| ESTADOS\n    ESTADOS ---|\&quot;1,n\&quot;| CIDADES\n    CIDADES ---|\&quot;1,n\&quot;| ENDERECOS\n    ENDERECOS ---|\&quot;1,n\&quot;| CLIENTES\n    CLIENTES ---|\&quot;1,n\&quot;| DOCUMENTOS_CLIENTES\n    CLIENTES ---|\&quot;1,1\&quot;| PREFERENCIAS_CLIENTES\n\n    %% Domínio 2\n    ENDERECOS ---|\&quot;1,n\&quot;| FILIAIS\n    DEPARTAMENTOS ---|\&quot;1,n\&quot;| CARGOS\n    FILIAIS ---|\&quot;1,n\&quot;| FUNCIONARIOS\n    CARGOS ---|\&quot;1,n\&quot;| FUNCIONARIOS\n    FUNCIONARIOS ---|\&quot;1,1\&quot;| AGENTES_VIAGEM\n    AGENTES_VIAGEM ---|\&quot;1,n\&quot;| METAS_VENDAS\n\n    %% Domínio 3\n    ENDERECOS ---|\&quot;1,n\&quot;| FORNECEDORES\n    FORNECEDORES ---|\&quot;1,n\&quot;| CONTATOS_FORNECEDORES\n    FORNECEDORES ---|\&quot;1,n\&quot;| CONTRATOS_FORNECEDORES\n    FORNECEDORES ---|\&quot;1,1\&quot;| COMPANHIAS_AEREAS\n    FORNECEDORES ---|\&quot;1,1\&quot;| REDES_HOTELEIRAS\n    FORNECEDORES ---|\&quot;1,1\&quot;| LOCADORAS_VEICULOS\n    FORNECEDORES ---|\&quot;1,1\&quot;| SEGURADORAS\n\n    %% Domínio 4\n    CIDADES ---|\&quot;1,n\&quot;| AEROPORTOS\n    COMPANHIAS_AEREAS ---|\&quot;1,n\&quot;| VOOS\n    AEROPORTOS ---|\&quot;1,n (origem)\&quot;| VOOS\n    AEROPORTOS ---|\&quot;1,n (destino)\&quot;| VOOS\n    VOOS ---|\&quot;1,n\&quot;| CLASSES_VOOS\n    REDES_HOTELEIRAS ---|\&quot;1,n\&quot;| HOTEIS\n    ENDERECOS ---|\&quot;1,n\&quot;| HOTEIS\n    HOTEIS ---|\&quot;1,n\&quot;| TIPOS_QUARTOS\n    TIPOS_QUARTOS ---|\&quot;1,n\&quot;| TARIFAS_HOTEIS\n    REGIMES_ALIMENTACAO ---|\&quot;1,n\&quot;| TARIFAS_HOTEIS\n    LOCADORAS_VEICULOS ---|\&quot;1,n\&quot;| CATEGORIAS_VEICULOS\n    SEGURADORAS ---|\&quot;1,n\&quot;| PLANOS_SEGURO\n    FORNECEDORES ---|\&quot;1,n\&quot;| PASSEIOS_TOURS\n    CIDADES ---|\&quot;1,n\&quot;| PASSEIOS_TOURS\n    FORNECEDORES ---|\&quot;1,n\&quot;| CRUZEIROS\n\n    %% Domínio 5\n    CIDADES ---|\&quot;1,n\&quot;| PACOTES_VIAGEM\n    PACOTES_VIAGEM ---|\&quot;1,n\&quot;| PACOTES_VOOS\n    CLASSES_VOOS ---|\&quot;1,n\&quot;| PACOTES_VOOS\n    PACOTES_VIAGEM ---|\&quot;1,n\&quot;| PACOTES_HOTEIS\n    TARIFAS_HOTEIS ---|\&quot;1,n\&quot;| PACOTES_HOTEIS\n    PACOTES_VIAGEM ---|\&quot;1,n\&quot;| PACOTES_PASSEIOS\n    PASSEIOS_TOURS ---|\&quot;1,n\&quot;| PACOTES_PASSEIOS\n    PACOTES_VIAGEM ---|\&quot;1,n\&quot;| PROMOCOES_PACOTES\n\n    %% Domínio 6\n    CLIENTES ---|\&quot;1,n\&quot;| COTACOES\n    AGENTES_VIAGEM ---|\&quot;1,n\&quot;| COTACOES\n    COTACOES ---|\&quot;1,1\&quot;| RESERVAS\n    CLIENTES ---|\&quot;1,n\&quot;| RESERVAS\n    AGENTES_VIAGEM ---|\&quot;1,n\&quot;| RESERVAS\n    RESERVAS ---|\&quot;1,n\&quot;| PASSAGEIROS_RESERVA\n    CLIENTES ---|\&quot;1,n\&quot;| PASSAGEIROS_RESERVA\n    RESERVAS ---|\&quot;1,n\&quot;| RESERVAS_VOOS\n    CLASSES_VOOS ---|\&quot;1,n\&quot;| RESERVAS_VOOS\n    RESERVAS ---|\&quot;1,n\&quot;| RESERVAS_HOTEIS\n    TARIFAS_HOTEIS ---|\&quot;1,n\&quot;| RESERVAS_HOTEIS\n    RESERVAS ---|\&quot;1,n\&quot;| RESERVAS_VEICULOS\n    CATEGORIAS_VEICULOS ---|\&quot;1,n\&quot;| RESERVAS_VEICULOS\n    RESERVAS ---|\&quot;1,n\&quot;| RESERVAS_EXTRAS\n    PLANOS_SEGURO ---|\&quot;1,n\&quot;| RESERVAS_EXTRAS\n    PASSEIOS_TOURS ---|\&quot;1,n\&quot;| RESERVAS_EXTRAS\n    CRUZEIROS ---|\&quot;1,n\&quot;| RESERVAS_EXTRAS\n\n    %% Domínio 7\n    RESERVAS ---|\&quot;1,n\&quot;| PAGAMENTOS\n    FORMAS_PAGAMENTO ---|\&quot;1,n\&quot;| PAGAMENTOS\n    RESERVAS ---|\&quot;1,n\&quot;| COMISSOES\n    AGENTES_VIAGEM ---|\&quot;1,n\&quot;| COMISSOES\n    RESERVAS ---|\&quot;1,n\&quot;| CONTAS_PAGAR_FORNECEDORES\n    FORNECEDORES ---|\&quot;1,n\&quot;| CONTAS_PAGAR_FORNECEDORES\n    CLIENTES ---|\&quot;1,1\&quot;| PROGRAMA_FIDELIDADE\n    PROGRAMA_FIDELIDADE ---|\&quot;1,n\&quot;| MOVIMENTACAO_PONTOS\n    RESERVAS ---|\&quot;1,n\&quot;| MOVIMENTACAO_PONTOS\n    RESERVAS ---|\&quot;1,1\&quot;| AVALIACOES_VIAGEM\n    CLIENTES ---|\&quot;1,n\&quot;| AVALIACOES_VIAGEM&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="O9IB4cT4JjytHIdH0AtD-129">
